# Godot 4 generated files
.godot/

# Export / build (artefacts à la RACINE uniquement — ancrés pour ne pas
# avaler un dossier source nommé build/, ex. scenes/holomap3d/build/)
/export/
/build/
*.import

# EXCEPTION (23/09/2026, perf combat) : décors de fond Ville/Usine VERSIONNÉS
# malgré la règle ci-dessus — c'est le SEUL moyen de faire voyager avec le
# dépôt le réglage `mipmaps/generate=true` qui a rendu le combat fluide (les
# canevas 4770×2655 sont affichés à ~30 % de leur taille source ; sans
# mipmaps, la minification à cette échelle coûtait ~25 % du temps de frame,
# mesuré). Un `--import` frais régénérerait sinon ces .import avec les
# réglages PAR DÉFAUT de Godot (mipmaps désactivés), et le gain disparaîtrait
# à l'insu de tout le monde. Scoped à ces deux dossiers UNIQUEMENT : pas de
# mipmaps sur les atlas Spine/UI packés (assets/personnages/, assets/ui/),
# où le mipmapping peut faire baver les sprites voisins d'une même page.
!assets/background/city/*.import
!assets/background/Factory/*.import

# Captures de l'outil dev ScreenshotTool
tests/_shot_*.png

# Aperçu généré par tools/make_icon.gd (l'icône finale = icon.ico, versionnée)
tools/_icon_preview.png

# Rapport généré par tools/inspect_glb.gd (vérif des props .glb de l'artiste)
tools/inspect_glb_out.txt

# Claude Code — local machine settings
.claude/settings.local.json

# Fichiers temporaires / sauvegardes Excel du gabarit de carte
Carte Holo/~$*.xlsx
Carte Holo/*_old.xlsx

# Résidus de copie Windows du GDExtension Spine (l'éditeur duplique le .dll au
# chargement ; un fichier resté verrouillé bloque la copie suivante → l'extension
# ne charge plus et Relic retombe sur son placeholder). Le vrai .dll est versionné.
bin/**/~*

# OS
.DS_Store
Thumbs.db
