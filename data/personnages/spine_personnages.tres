[gd_resource type="Resource" script_class="SpinePersonnagesData" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/resources/SpinePersonnagesData.gd" id="1"]

[resource]
script = ExtResource("1")
; Relic — livraison « costumes » du 24/08/2026. L'export n'a PAS une skin par
; apparence : il empile un corps (Men_Global), les pièces d'équipement
; (Men_Level + Men_Level_Hit) et un accessoire de visage « Random ». Ces skins
; se CUMULENT (skins_base + un jeu de `cosmetiques`), et les 6 paliers
; d'équipement sont portés par des SLOTS suffixés « _Nv1 » … « _Nv6 » — d'où
; `niveaux: 6` (voir SpriteSpinePersonnage pour la purge de skin).
; Les versions masculine / féminine ne sont pas livrées : `variantes` reste
; vide. Le jour où Christophe les nomme, il suffit de les ajouter ici —
; la ShowRoom les montrera sans modification de code :
;   "variantes": [{"skin": "Relic_M", "nom": "Masculin"},
;                 {"skin": "Relic_F", "nom": "Féminin"}]
;
; CHEVEUX (livraison du 25/08/2026) : deux coiffures ALTERNATIVES,
; « Men_Random_Level_Hair_1 » (slots …_Cheveux1_Nv1…6) et « …_Hair_2 »
; (slots …_Cheveux2_Nv1…6). Elles sont exclusives — les cumuler poserait
; deux chevelures à la fois. Hair_1 est le socle par défaut ; le jour où
; le joueur choisit sa coiffure, elles deviennent un axe à part entière
; (les `cosmetiques` sont déjà pris par les accessoires de visage).
;
; VÊTEMENT — même trajectoire annoncée par Christophe (25/08/2026) :
; « Men_Random_Level_Clothing_1 » est dans `skins_base` parce qu'il est SEUL.
; Dès qu'un « _Clothing_2 » est livré, la famille devient EXCLUSIVE comme les
; coiffures et les visages, et sort de `skins_base`. Trois familles alternatives
; pour un seul axe `cosmetiques` : c'est ce jour-là qu'il faudra trancher entre
; plusieurs axes indépendants et un produit cartésien de jeux nommés.
; SENS D'EXPORT (`regarde_a_droite`, 27/08/2026) — décrit L'ASSET, pas la mise
; en scène. Christophe dessine CHAQUE CAMP PRÊT À L'EMPLOI : le héros tourné
; vers la DROITE, les ennemis vers la GAUCHE. Posés à leurs ancrages (joueur à
; gauche, adverse à droite), ils se font donc face SANS AUCUN MIROIR.
;
; ⚠ Se fier à l'ARME pour lire le sens est un piège : le FlameBot porte son
; canon en travers du corps, pointé vers l'arrière-droite, alors que sa TÊTE
; (masque en V, optiques) regarde à gauche. C'est le REGARD qui donne le sens.
; Le miroir posé sur cette mauvaise lecture retournait les ennemis DOS à Relic.
;
; Le champ reste là pour le jour où une livraison arrivera dans l'autre sens :
; une ligne à changer sur SON entrée, aucun code à toucher.
personnages = [{
"id": "relic",
"nom": "Relic (héros)",
"skel": "res://assets/personnages/relic/Relic.skel",
"atlas": "res://assets/personnages/relic/Relic.atlas",
"prefixe_skin": "",
"variantes": [],
"skins_base": ["Men_Global", "Men_Level", "Men_Level_Hit", "Men_Random_Level_Clothing_1", "Men_Random_Level_Hair_1"],
"cosmetiques": [{
"nom": "Visage 1",
"skins": ["Men_Random_Face_Accessory_1"]
}, {
"nom": "Visage 2",
"skins": ["Men_Random_Face_Accessory_2"]
}, {
"nom": "Visage 3",
"skins": ["Men_Random_Level_Face_Accessory_3"]
}],
"decalage_x_px": 17.0,
"niveaux": 6,
"regarde_a_droite": true,
"ennemi": false
}, {
"id": "flamebot",
"nom": "FlameBot",
"skel": "res://assets/personnages/ennemis/flamebot/FlameBot.skel",
"atlas": "res://assets/personnages/ennemis/flamebot/FlameBot.atlas",
"prefixe_skin": "FlameBot_Nv",
"regarde_a_droite": false,
"ennemi": true
}, {
"id": "workbot",
"nom": "WorkBot",
"skel": "res://assets/personnages/ennemis/workbot/WorkBot.skel",
"atlas": "res://assets/personnages/ennemis/workbot/WorkBot.atlas",
"prefixe_skin": "WorkBot_Nv",
"regarde_a_droite": false,
"ennemi": true
}]
