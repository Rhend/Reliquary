[resource]
script = ExtResource("1")
id = "sea_shell"
nom_affichage_fr = "Coquillage Magique"
lore_fr = "Ramasse loin de toute mer, on ne sait pas comment il est arrive la. Le tenir contre l'oreille ne fait pas entendre la mer - mais quelque chose d'autre."
lore_en = "Picked up far from any sea, no one knows how it got here. Holding it to your ear doesn't bring the sound of waves - but something else."
nom_affichage_en = "Magic Shell"
biome_source_id = "biome_montagne"
effet = "xp_bonus"
valeur = 50

maitrise_actuelle = 0
xp_maitrise_actuelle = 0.0
xp_maitrise_palier_suivant = 0.0
