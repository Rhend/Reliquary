noms_par_palier_en = {0: "Hot Spring", 1: "Mineral Spring", 2: "Regenerating Geyser", 3: "Hot Stone Bath", 4: "Sacred Spring", 5: "Breath of the Mountain's Heart"}
biome_source_id = "biome_montagne"
