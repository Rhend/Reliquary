[resource]
script = ExtResource("1")
id = "champignon_magique"
nom_affichage_fr = "Champignon Magique"
lore_fr = "Il pousse dans l'obscurite totale et brille faiblement. Le consommer procure une clarte inattendue, comme si le monde s'etait mis en pause."
lore_en = "It grows in total darkness and glows faintly. Eating it brings unexpected clarity, as if the world had been put on pause."
nom_affichage_en = "Magic Mushroom"
noms_par_palier_fr = {0: "Champignon Magique", 1: "Spore Lumineuse", 2: "Champignon Phosphorescent", 3: "Bouquet Mycélien", 4: "Floraison Nocturne", 5: "Don du Grand Mycélium"}
noms_par_palier_en = {0: "Magic Mushroom", 1: "Glowing Spore", 2: "Phosphorescent Mushroom", 3: "Mycelial Cluster", 4: "Night Bloom", 5: "Gift of the Great Mycelium"}
biome_source_id = "biome_marecage"
effet = "xp_bonus"
valeur = 50

maitrise_actuelle = 0
xp_maitrise_actuelle = 0.0
xp_maitrise_palier_suivant = 0.0
