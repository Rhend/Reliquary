0: [{"channel": "def_pct", "value": 0.05}],
1: [{"channel": "def_pct", "value": 0.03}],
2: [{"channel": "hp_max_pct", "value": 0.08}],
3: [{"channel": "def_pct", "value": 0.04}],
4: [{"channel": "hp_max_pct", "value": 0.04}],
5: [{"channel": "def_pct", "value": 0.06}, {"channel": "ignore_first_lethal", "value": 1}]
}
