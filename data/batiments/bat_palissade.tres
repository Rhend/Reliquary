[ext_resource type="Script" path="res://scripts/resources/BuildingData.gd" id="1"]

[resource]
script = ExtResource("1")
id = "bat_palissade"
quartier = "adventure"
nom_affichage_fr = "Palissade"
nom_affichage_en = "Palisade"
lore_fr = "Des pieux dressés et des remparts de fortune. Ce qui protège le village endurcit aussi celui qui en part."
lore_en = "Raised stakes and makeshift ramparts. What shields the village also hardens the one who leaves it."
biome_principal_id = "biome_montagne"
biomes_additionnels = Array[String](["biome_foret", "biome_marecage"])
