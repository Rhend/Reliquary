noms_par_palier_en = {0: "Quickmud", 1: "Deep Mire", 2: "Corrosive Sludge", 3: "Devouring Bog", 4: "Sinkhole of Sludge", 5: "The Putrid Abyss"}
biome_source_id = "biome_marecage"
