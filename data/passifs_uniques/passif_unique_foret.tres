[resource]
script = ExtResource("1")
id = "passif_unique_foret"
nom_affichage_fr = "Essence de Forêt"
lore_fr = "La foret sombre laisse une trace en ceux qui la traversent. Cette essence concentre sa memoire vivante - les racines, les murmures, la nuit entre les arbres."
lore_en = "The dark forest leaves a mark on those who cross it. This essence concentrates its living memory - the roots, the whispers, the night between the trees."
nom_affichage_en = "Forest Essence"
noms_par_palier_fr = {0: "Essence de Forêt", 1: "Essence des Bois", 2: "Essence de l'Ancienne Forêt", 3: "Murmure de la Forêt", 4: "Bénédiction du Bosquet Sacré", 5: "Don du Gardien Maudit"}
noms_par_palier_en = {0: "Forest Essence", 1: "Essence of the Woods", 2: "Essence of the Old Forest", 3: "Whisper of the Forest", 4: "Blessing of the Sacred Grove", 5: "Gift of the Cursed Guardian"}
biome_source_id = "biome_foret"
est_debloque = false
maitrise_actuelle = 0
xp_maitrise_actuelle = 0
